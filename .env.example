# Copy to .env (git-ignored). Only needed for live calls; `pnpm demo` needs no key.

# Which API to call: openrouter-decisions (OpenRouter's structured Decisions API)
# or openai-compatible (any /chat/completions endpoint).
HARNESS_PROVIDER=openrouter-decisions
HARNESS_MODEL=~typesafe/jev-latest

# For openai-compatible: base URL of the API (default https://openrouter.ai/api/v1).
# HARNESS_BASE_URL=http://127.0.0.1:8000/v1

# Key: OPENROUTER_API_KEY for OpenRouter, or HARNESS_API_KEY for anything else.
OPENROUTER_API_KEY=
# HARNESS_API_KEY=

# Hard stop before the next request once this much is spent (runs/spend.json).
HARNESS_SPEND_CAP_USD=5

# Price per million tokens, for APIs that do not report a cost. If unset and the API
# reports no cost, every call is booked at HARNESS_FALLBACK_CALL_USD (default 0.05).
# Set both to 0 for a local server.
# HARNESS_PRICE_IN_PER_M=0
# HARNESS_PRICE_OUT_PER_M=0
